# Used only by domain_assistant.py when generating real RAG answers.
# Copy this file to .env, then replace the placeholder value.

# Option 1: Using OpenAI API
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Option 2: Using Google Gemini API (Recommended if you have a Gemini API key)
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash
# (Endpoint is auto-configured to https://generativelanguage.googleapis.com/v1beta/openai/)
